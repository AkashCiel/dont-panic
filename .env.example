# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ─── LLM ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=

# ─── Telegram notifications ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Source-specific auth ─────────────────────────────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
GITHUB_TOKEN=

# ─── Configuration ────────────────────────────────────────────────────────────
REPORT_INTERVAL_DAYS=3
FETCH_SCHEDULE_UTC=0600
